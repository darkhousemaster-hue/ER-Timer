{
  "name": "er-timer",
  "version": "3.0.2",
  "description": "Escape Room dual-room timer",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "release": "npm version patch && git push --follow-tags"
  },
  "build": {
    "appId": "com.ertimer.app",
    "productName": "ER Timer",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ER Timer",
      "uninstallDisplayName": "ER Timer",
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/linux",
      "category": "Utility",
      "synopsis": "Escape Room dual-room timer",
      "maintainer": "darkhousemaster-hue <darkhousemaster-hue@users.noreply.github.com>",
      "executableArgs": [
        "--ozone-platform=x11"
      ]
    },
    "appImage": {
      "artifactName": "ER-Timer-${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/icons/linux/**",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "darkhousemaster-hue",
      "repo": "ER-Timer",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "electron-log": "^5.0.0"
  }
}
